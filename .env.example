# --- LLM providers (at least one) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Search (web mode) ---
TAVILY_API_KEY=

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=research-agent

# --- Internal RAG: Ollama (local LLM + embeddings) ---
# Install: `brew install ollama && ollama serve`
# Pull:    `ollama pull qwen2.5:7b && ollama pull nomic-embed-text`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Internal RAG: Confluence wiki ---
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=
CONFLUENCE_USER=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=        # comma-separated, optional filter (e.g. ENG,PRD)

# --- Internal RAG: Slack ---
#
# RECOMMENDED: User OAuth Token (xoxp-...) — uses YOUR Slack permissions,
# so the bot DOES NOT need to be invited to channels. You can read every
# channel you are already a member of.
#
# Setup steps:
#  1. https://api.slack.com/apps → Create New App → From scratch
#  2. OAuth & Permissions → "User Token Scopes" 추가:
#       - channels:history     (public 채널 메시지)
#       - channels:read        (public 채널 목록)
#       - users:read           (사용자 이름)
#       - groups:history       (선택, 본인이 멤버인 private 채널)
#       - groups:read          (선택)
#  3. "Install to Workspace" → "User OAuth Token" (xoxp-...) 복사
#
# 또는 Bot Token (xoxb-) 도 호환되지만 봇을 채널에 초대해야 함.
SLACK_TOKEN=                   # xoxp-... (user, 권장) 또는 xoxb-... (bot)
SLACK_CHANNELS=              # comma-separated channel names (e.g. eng,product). Empty = all you can see
SLACK_LOOKBACK_DAYS=30
SLACK_WORKSPACE_SUBDOMAIN=     # e.g. todomath  (for clean archive URLs)
SLACK_INCLUDE_PRIVATE=false    # true 로 하면 본인이 가입한 private 채널도 포함 (groups:* scope 필요)

# --- Internal RAG: vector index dir (gitignored) ---
INTERNAL_VECTOR_DB=./internal_chroma
